<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sys="clr-namespace:System;assembly=netstandard"
             xmlns:IF="clr-namespace:ThaiReference.Contracts;assembly=ThaiReference.App"
             xmlns:models="clr-namespace:ThaiReference.Models;assembly=ThaiReference.App"
             xmlns:dataModels="clr-namespace:ThaiReference.Models;assembly=ThaiReference"
             xmlns:modelIF="clr-namespace:ThaiReference.Models.Interfaces;assembly=ThaiReference"
             xmlns:android="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.AndroidSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:conv="clr-namespace:ThaiReference.Converters;assembly=ThaiReference.App"
             xmlns:ut="clr-namespace:ThaiReference.Utilities"
             xmlns:ctrl="clr-namespace:ThaiReference.Controls"
             xmlns:vms="clr-namespace:ThaiReference.ViewModels">
    <DataTemplate x:Key="ConsonantButtonSoundGroupTemplate" x:DataType="{x:Type modelIF:IConsonant}">
        <Button Style="{StaticResource ConsonantButtonSoundGroupStyle}"/>
    </DataTemplate>
    <DataTemplate x:Key="ConsonantButtonSoundTypeGroupTemplateInitial" x:DataType="{x:Type modelIF:IConsonant}">
        <Button Style="{StaticResource ConsonantButtonSoundTypeGroupStyleInitial}"/>
    </DataTemplate>
    <DataTemplate x:Key="ConsonantButtonSoundTypeGroupTemplateFinal" x:DataType="{x:Type modelIF:IConsonant}">
        <Button Style="{StaticResource ConsonantButtonSoundTypeGroupStyleFinal}"/>
    </DataTemplate>
    <DataTemplate x:Key="SampleWordItem" x:DataType="{x:Type modelIF:IWord}">
        <StackLayout>
            <Button BindingContext="{Binding .}" Style="{StaticResource WordButton}"/>
            <Label HorizontalOptions="Center" Margin="5,0" Text="{Binding LexemesString, TargetNullValue={x:Null}, FallbackValue={x:Null}}"
                   TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}"/>
        </StackLayout>
    </DataTemplate>

            <SwipeView.RightItems>
                <SwipeItems Mode="Execute">
                    <SwipeItem
                        Command="{Binding ToDetailsCommand, Source={RelativeSource AncestorType={x:Type IF:IDetailsNavigable}}}"
                        CommandParameter="{Binding Consonant}">
                        <SwipeItem.IconImageSource>
                            <FontImageSource FontFamily="MaterialIconsSharp-Regular" Glyph="&#xE5C8;" Size="24"
                                             Color="{AppThemeBinding Light={StaticResource PrimaryDarkText}, Dark={StaticResource White}}"/>
                        </SwipeItem.IconImageSource>
                    </SwipeItem>
                </SwipeItems>
            </SwipeView.RightItems>
            <Button VerticalOptions="Start" Style="{StaticResource ConsonantButton}"/>
        </SwipeView>

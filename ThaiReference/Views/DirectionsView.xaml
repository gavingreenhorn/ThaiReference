<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ThaiReference.ViewModels"
             xmlns:ui="clr-namespace:ThaiReference.Ui"
             x:Class="ThaiReference.Views.DirectionsView"
             x:DataType="vm:DirectionsViewModel"
             Title="{ui:UiLabel shell.directions}">

    <Grid RowDefinitions="*, Auto" Padding="12" RowSpacing="12">

        <AbsoluteLayout x:Name="CompassDial"
                        Grid.Row="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="400"
                        HeightRequest="400" />

        <Border
            Grid.Row="1"
            StrokeShape="RoundRectangle 10"
            Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceInsetLight}, Dark={StaticResource SurfaceInsetDark}}"
            Padding="16"
            MinimumHeightRequest="100">
            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">

                <Grid Grid.Row="0" Grid.Column="0">
                    <Label
                        Text="ทิศ"
                        FontFamily="{DynamicResource CurrentThaiFont}"
                        FontSize="28"
                        TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedDirection}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label
                        Text="{Binding SelectedDirection.Spelling}"
                        FontFamily="{DynamicResource CurrentThaiFont}"
                        FontSize="28"
                        TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedDirection}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,2,0,0">
                    <Label
                        Text=" "
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}"
                        IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedDirection}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedDirection}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Label.Triggers>
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource PropertyAccessorConverter}">
                                <Binding Path="SelectedDirection.Transcription"/>
                                <Binding Path="BindingContext.RomanizationOption" Source="{RelativeSource AncestorType={x:Type ContentPage}}"/>
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="0" Margin="0,4,0,0">
                    <Label
                        Text="{ui:UiLabel hint.directions_tap}"
                        FontFamily="{DynamicResource CurrentChromeFont}"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}"
                        IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedDirection}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label
                        Text="{Binding SelectedDirection.Lexeme}"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedDirection}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>

                <Button
                    Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                    Style="{StaticResource PlayButton}"
                    Command="{Binding PronounceCommand}"
                    CommandParameter="{Binding SelectedDirection}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedDirection}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </Grid>
        </Border>

    </Grid>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:ThaiReference.Ui"
             xmlns:vm="clr-namespace:ThaiReference.ViewModels"
             x:Class="ThaiReference.Views.PositionsView"
             x:DataType="vm:PositionsViewModel"
             Title="{ui:UiLabel shell.position}">

    <Grid RowDefinitions="*, Auto, Auto" Padding="12" RowSpacing="12">

        <CarouselView x:Name="PositionCarousel"
                      Grid.Row="0"
                      Style="{StaticResource PeekCarousel}"
                      ItemsSource="{Binding Positions}"
                      Loop="False"
                      Scrolled="OnPositionCarouselScrolled"
                      CurrentItemChanged="OnPositionCarouselCurrentItemChanged"
                      IndicatorView="{Reference PositionIndicator}">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="vm:PositionWord">
                    <Border Style="{StaticResource CarouselPaneCard}">
                        <Grid RowDefinitions="Auto, Auto, *" RowSpacing="8" HorizontalOptions="Fill">
                            <Label Grid.Row="0"
                                   Style="{StaticResource GroupCardTitle}"
                                   FontFamily="{DynamicResource CurrentThaiFont}"
                                   Text="{Binding Header}"/>
                            <BoxView Grid.Row="1" Style="{StaticResource GroupCardSeparator}"/>
                            <GraphicsView Grid.Row="2"
                                          Drawable="{Binding Scene}"
                                          VerticalOptions="Fill"
                                          HorizontalOptions="Fill"
                                          StartInteraction="OnSceneStartInteraction" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView x:Name="PositionIndicator"
                       Grid.Row="1"
                       Style="{StaticResource CarouselIndicator}"/>

        <Border
            Grid.Row="2"
            StrokeShape="RoundRectangle 10"
            Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceInsetLight}, Dark={StaticResource SurfaceInsetDark}}"
            Padding="12,10">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12" RowDefinitions="Auto, Auto">
                <Label
                    Grid.Row="0" Grid.Column="0"
                    Text="{Binding CurrentItem.ExampleThai}"
                    FontFamily="{DynamicResource CurrentThaiFont}"
                    FontSize="20"
                    TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                    LineBreakMode="WordWrap"/>
                <Label
                    Grid.Row="1" Grid.Column="0"
                    FontSize="13"
                    TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedYellowDark}}"
                    Margin="0,2,0,0">
                    <Label.Text>
                        <MultiBinding Converter="{StaticResource PropertyAccessorConverter}">
                            <Binding Path="CurrentItem.ExampleTranscription"/>
                            <Binding Path="BindingContext.RomanizationOption" Source="{RelativeSource AncestorType={x:Type ContentPage}}"/>
                        </MultiBinding>
                    </Label.Text>
                </Label>
                <Button
                    Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                    Style="{StaticResource PlayButton}"
                    Command="{Binding PronounceCommand}"
                    CommandParameter="{Binding CurrentItem.PronounceTarget}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding CurrentItem}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

    </Grid>
</ContentPage>

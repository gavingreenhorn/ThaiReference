<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:ThaiReference.Ui"
             xmlns:vms="clr-namespace:ThaiReference.ViewModels"
             xmlns:controls="clr-namespace:ThaiReference.Controls"
             x:Class="ThaiReference.Views.SettingsView"
             x:DataType="vms:SettingsViewModel"
             Title="{ui:UiLabel account.appearance}">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PageContentPadding}" Spacing="20">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding UiLanguageLabel}" FontFamily="{DynamicResource CurrentChromeFont}"/>
                <controls:OptionStrip ItemsSource="{Binding UiLanguageOptions}"
                                      SelectedItem="{Binding SelectedUiLanguageOption, Mode=TwoWay}"
                                      TextPropertyName="Thai" HeightRequest="44"/>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="{Binding PreferRecordingsLabel}" VerticalTextAlignment="Center"
                       FontFamily="{DynamicResource CurrentChromeFont}"/>
                <Switch Grid.Column="1" IsToggled="{Binding PreferRecorded}"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ThaiReference.ViewModels"
             xmlns:ui="clr-namespace:ThaiReference.Ui"
             x:Class="ThaiReference.Views.ColorsView"
             x:DataType="vm:ColorsViewModel"
             Title="{ui:UiLabel shell.colors}">

    <Grid RowDefinitions="*, Auto" Padding="12" RowSpacing="12">

        <GraphicsView x:Name="ColorWheel"
                      Grid.Row="0"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      WidthRequest="360"
                      HeightRequest="360" />

        <Border
            Grid.Row="1"
            StrokeShape="RoundRectangle 10"
            Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceInsetLight}, Dark={StaticResource SurfaceInsetDark}}"
            Padding="16"
            MinimumHeightRequest="100">
            <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12">

                <Border
                        Grid.Row="0" Grid.Column="0" Grid.RowSpan="3"
                        WidthRequest="48"
                        HeightRequest="48"
                        StrokeShape="RoundRectangle 6"
                        Stroke="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        Padding="0"
                        BackgroundColor="{Binding SelectedColor.Hex, Converter={StaticResource HexToColorConverter}, FallbackValue=Transparent, TargetNullValue=Transparent}"/>

                <Grid Grid.Row="0" Grid.Column="1">
                    <Label
                        Text="สี"
                        FontFamily="{DynamicResource CurrentThaiFont}"
                        FontSize="28"
                        TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedColor}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label
                        Text="{Binding SelectedColor.Spelling}"
                        FontFamily="{DynamicResource CurrentThaiFont}"
                        FontSize="28"
                        TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedColor}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="1" Margin="0,2,0,0">
                    <Label
                        Text=" "
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}"
                        IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedColor}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedColor}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Label.Triggers>
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource PropertyAccessorConverter}">
                                <Binding Path="SelectedColor.Transcription"/>
                                <Binding Path="BindingContext.RomanizationOption" Source="{RelativeSource AncestorType={x:Type ContentPage}}"/>
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="1" Margin="0,4,0,0">
                    <Label
                        Text="{ui:UiLabel hint.colors_tap}"
                        FontFamily="{DynamicResource CurrentChromeFont}"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}"
                        IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedColor}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedColor}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Label.Triggers>
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource LocalizedColorLabelConverter}">
                                <Binding Path="SelectedColor"/>
                                <Binding Path="Language" Source="{x:Static ui:UiLanguageState.Instance}"/>
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </Grid>

                <Button
                    Grid.Row="0" Grid.Column="2" Grid.RowSpan="3"
                    Style="{StaticResource PlayButton}"
                    Command="{Binding PronounceCommand}"
                    CommandParameter="{Binding SelectedColor}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedColor}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </Grid>
        </Border>

    </Grid>
</ContentPage>

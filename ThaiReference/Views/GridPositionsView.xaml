<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vms="clr-namespace:ThaiReference.ViewModels"
             xmlns:models="clr-namespace:ThaiReference.Models;assembly=ThaiReference.App"
             xmlns:ui="clr-namespace:ThaiReference.Ui"
             x:Class="ThaiReference.Views.GridPositionsView"
             x:DataType="vms:GridPositionsViewModel"
             Title="{ui:UiLabel shell.grid}">

    <Grid RowDefinitions="*, Auto" Padding="12" RowSpacing="12">

        <ScrollView Grid.Row="0">
            <Grid ColumnSpacing="0" RowSpacing="0" Padding="5">
                <Grid.Resources>
                    <Style TargetType="Label">
                        <Setter Property="HeightRequest" Value="56"/>
                        <Setter Property="HorizontalTextAlignment" Value="Center"/>
                        <Setter Property="VerticalTextAlignment" Value="Center"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="5" ColumnDefinitions="*, *, *, *, *">
                    <Label Grid.Column="0" Text="๑"/>
                    <Label Grid.Column="1" Text="๒"/>
                    <Label Grid.Column="2" Text="๓"/>
                    <Label Grid.Column="3" Text="๔"/>
                    <Label Grid.Column="4" Text="๕"/>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" RowSpacing="5" RowDefinitions="*, *, *, *, *">
                    <Label Grid.Row="0" Text="๑"/>
                    <Label Grid.Row="1" Text="๒"/>
                    <Label Grid.Row="2" Text="๓"/>
                    <Label Grid.Row="3" Text="๔"/>
                    <Label Grid.Row="4" Text="๕"/>
                </Grid>

                <VerticalStackLayout
                    Grid.Row="1" Grid.Column="1" Spacing="5"
                    BindableLayout.ItemsSource="{Binding GridRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:PositionGridRow">
                            <CollectionView
                                ItemsSource="{Binding Cells}"
                                ItemsLayout="VerticalGrid, 5"
                                ItemTemplate="{StaticResource PositionGridCellItem}"
                                SelectionMode="None"
                                HeightRequest="56"
                                HorizontalOptions="Fill"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <Border
            Grid.Row="1"
            StrokeShape="RoundRectangle 10"
            Stroke="{AppThemeBinding Light={StaticResource PanelStrokeLight}, Dark={StaticResource PanelStrokeDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceInsetLight}, Dark={StaticResource SurfaceInsetDark}}"
            Padding="16"
            MinimumHeightRequest="100">
            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">

                <Grid Grid.Row="0" Grid.Column="0">
                    <Label
                        Text="ช่อง"
                        FontFamily="{DynamicResource CurrentThaiFont}"
                        FontSize="28"
                        TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}"
                        IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedCell}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label
                        Text="{Binding SelectedCell.Caption}"
                        FontFamily="{DynamicResource CurrentThaiFont}"
                        FontSize="28"
                        TextColor="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedCell}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,2,0,0">
                    <Label
                        Text=" "
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}"
                        IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedCell}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label
                        FontSize="13"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedCell}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Label.Triggers>
                        <Label.Text>
                            <MultiBinding Converter="{StaticResource PropertyAccessorConverter}">
                                <Binding Path="SelectedTranscription"/>
                                <Binding Path="BindingContext.RomanizationOption" Source="{RelativeSource AncestorType={x:Type ContentPage}}"/>
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </Grid>

                <Grid Grid.Row="2" Grid.Column="0" Margin="0,4,0,0">
                    <Label
                        Text="{ui:UiLabel hint.grid_tap}"
                        FontFamily="{DynamicResource CurrentChromeFont}"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}"
                        IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedCell}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label
                        Text="{Binding SelectedCell.Label}"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource SubduedLight}, Dark={StaticResource SubduedDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SelectedCell}" Value="{x:Null}">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>

                <Button
                    Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                    Style="{StaticResource PlayButton}"
                    Command="{Binding PronounceCommand}"
                    CommandParameter="{Binding SelectedCell}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding SelectedCell}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

            </Grid>
        </Border>

    </Grid>
</ContentPage>

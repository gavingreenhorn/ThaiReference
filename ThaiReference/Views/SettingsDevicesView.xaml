<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:ThaiReference.Ui"
             xmlns:vms="clr-namespace:ThaiReference.ViewModels"
             x:Class="ThaiReference.Views.SettingsDevicesView"
             x:DataType="vms:SettingsViewModel"
             Title="{ui:UiLabel account.devices}">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PageContentPadding}" Spacing="10">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vms:DeviceMemberItem">
                        <Grid ColumnDefinitions="*,Auto" Padding="8" ColumnSpacing="8">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding ThisDevice}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceInsetLight}, Dark={StaticResource SurfaceInsetDark}}"/>
                                </DataTrigger>
                            </Grid.Triggers>
                            <Label Text="{Binding Display}" VerticalTextAlignment="Center"
                                   FontFamily="{DynamicResource UIFont}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding ThisDevice}" Value="True">
                                        <Setter Property="FontAttributes" Value="Bold"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Button Style="{StaticResource UiButton}" Text="{ui:UiLabel account.unlink}"
                                        Command="{Binding UnlinkCommand}" CommandParameter="{Binding .}"/>
                                <Button Style="{StaticResource UiButton}" Text="{ui:UiLabel account.transfer_owner}"
                                        Command="{Binding TransferOwnerCommand}" CommandParameter="{Binding .}"
                                        IsVisible="{Binding CanReceiveOwnership}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="{Binding StatusMessage}" FontFamily="{DynamicResource CurrentChromeFont}"/>
            <HorizontalStackLayout Spacing="8">
                <Button Style="{StaticResource UiButton}" Text="{Binding ShowQrLabel}" Command="{Binding ShowQrCommand}"/>
                <Button Style="{StaticResource UiButton}" Text="{Binding ScanQrLabel}" Command="{Binding ScanQrCommand}"/>
            </HorizontalStackLayout>
            <VerticalStackLayout IsVisible="{Binding QrVisible}" Spacing="8">
                <Image Source="{Binding QrImage}" HeightRequest="220" WidthRequest="220"
                       HorizontalOptions="Center" Aspect="AspectFit"/>
                <Button Style="{StaticResource UiButton}" Text="{Binding HideQrLabel}" Command="{Binding HideQrCommand}"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

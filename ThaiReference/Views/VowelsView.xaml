<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:ThaiReference.Ui"
             xmlns:vms="clr-namespace:ThaiReference.ViewModels"
             x:Class="ThaiReference.Views.VowelsView"
             x:DataType="vms:VowelsViewModel"
             Title="{ui:UiLabel shell.vowels}">
    <Grid RowDefinitions="Auto,*"
          Padding="{StaticResource PageContentPadding}"
          RowSpacing="8">
        <Picker
            Title="{Binding ViewOptionsTitle}"
            ItemsSource="{Binding VowelViewOptions}"
            SelectedItem="{Binding SelectedVowelViewOption, Mode=TwoWay}"
            ItemDisplayBinding="{Binding Name}"/>
        <ContentView Content="{Binding SelectedVowelViewOption.View, Mode=OneWay}" Grid.Row="1"/>
    </Grid>
</ContentPage>
